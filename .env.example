NODE_ENV=development
PORT=3001

# Local PostgreSQL. Use DATABASE_SSL=true for a hosted TLS connection.
DATABASE_URL=postgresql://nexus:nexus_local@localhost:5432/nexus_ai
DATABASE_SSL=false

REDIS_URL=redis://localhost:6379
QUEUES_ENABLED=true
PLANNING_EVALUATION_CONCURRENCY=2
PROJECT_PLAN_GENERATION_CONCURRENCY=2
AI_JOB_MONITOR_ENABLED=true
AI_JOB_MONITOR_INTERVAL_MS=300000
AI_JOB_STUCK_QUEUED_MS=900000
AI_JOB_STUCK_RUNNING_MS=600000
AI_JOB_FAILURE_ALERT_THRESHOLD=3

FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=360000
EVALUATION_SANDBOX_MODE=http
PROJECT_MIN_LEAD_TIME_DAYS=3

JWT_SECRET=replace-with-a-long-random-secret

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Requirements documents are stored as authenticated Cloudinary assets and
# processed asynchronously. ClamAV scanning is mandatory by default in
# production; keep it optional only for local development.
REQUIREMENTS_DOCUMENT_MALWARE_SCAN_REQUIRED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
REQUIREMENTS_DOCUMENT_UPLOADS_PER_HOUR=5
REQUIREMENTS_DOCUMENT_UPLOAD_MIN_INTERVAL_SECONDS=10

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Phone verification is disabled by default. When enabled locally, use a fixed
# numeric code instead of SMS. When enabled in production, Twilio is required.
PHONE_VERIFICATION_REQUIRED=false
PHONE_VERIFICATION_TEST_CODE=123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=10
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/settings
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/settings
# In test mode, enable automatic idempotent Connect transfers after approval.
STRIPE_ENABLE_TRANSFERS=true
FREELANCER_RATE_BASE_CURRENCY=EGP
FREELANCER_MIN_HOURLY_RATE=150
FREELANCER_MAX_HOURLY_RATE=1200
# Invitations automatically expire and move to the next ranked candidate.
MATCHING_INVITATION_TTL_HOURS=5
MATCHING_GUARANTEED_FALLBACK_ATTEMPTS=2
MATCHING_EMPTY_RUN_RETRY_MINUTES=15
# Rates per USD used to compare freelancer rates with project/task currencies.
CURRENCY_RATES_PER_USD=USD:1,EGP:48.5,EUR:0.92,GBP:0.79

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_URL=
GITHUB_DEFAULT_VISIBILITY=private
GITHUB_API_URL=https://api.github.com
GITHUB_API_TIMEOUT_MS=30000

# Final delivery automation retries infrastructure failures and gives the
# customer this long to review a principal-approved integrated build.
FINAL_HANDOFF_AUTOMATION_ENABLED=true
CLIENT_REVIEW_WINDOW_HOURS=72
